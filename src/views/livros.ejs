<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <title>Biblioteca</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f3f5f8; margin: 0; padding: 32px; color: #1b2430; }
    .card { max-width: 760px; margin: 0 auto; background: #fff; border-radius: 12px; padding: 24px 28px; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    h1 { margin: 0 0 16px; font-size: 26px; }
    .msg { padding: 10px 14px; border-radius: 8px; margin-bottom: 14px; font-size: 15px; }
    .erro { background: #fde2e2; color: #9b1c1c; }
    .ok { background: #dcf5e4; color: #14633a; }
    .livro { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid #e6eaf0; }
    .livro b { font-size: 17px; }
    .livro small { color: #5b6675; }
    form { display: flex; gap: 8px; }
    input { padding: 8px 10px; border: 1px solid #c8d0db; border-radius: 6px; width: 110px; font-size: 14px; }
    button { padding: 8px 14px; border: 0; border-radius: 6px; background: #2563eb; color: #fff; font-weight: 600; cursor: pointer; }
    .selo { background: #fde2e2; color: #9b1c1c; padding: 4px 10px; border-radius: 99px; font-size: 13px; font-weight: 700; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Biblioteca</h1>
    <% if (erro) { %>
      <div class="msg erro"><%= erro %></div>
    <% } %>
    <% if (ok) { %>
      <div class="msg ok"><%= ok %></div>
    <% } %>

    <% livros.forEach(function (livro) { %>
      <div class="livro">
        <div>
          <b><%= livro.titulo %></b><br>
          <small><%= livro.autor %></small>
        </div>
        <% if (livro.disponivel) { %>
          <form method="post" action="/livros/<%= livro.id %>/emprestar">
            <input name="matricula" placeholder="Matrícula" maxlength="6">
            <button>Emprestar</button>
          </form>
        <% } else { %>
          <span class="selo">Emprestado</span>
        <% } %>
      </div>
    <% }) %>
  </div>
</body>
</html>
